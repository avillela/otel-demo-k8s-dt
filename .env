# Dynatrace configs
DT_URL=<your_dynatrace_url>
K8S_CLUSTER_NAME=otel-demo

DT_OPERATOR_TOKEN=<your_dynatrace_operator_token>
DT_OTEL_TOKEN=<your_dynatrace_token>

# GCP environment variables
GCP_PROJECT_NAME=<your_gcp_project_name>
GCP_REGION=<your_gcp_region>
GCP_ZONE=<your_gcp_zone>

GKE_CLUSTER_NAME=${K8S_CLUSTER_NAME}
GKE_MACHINE_TYPE=<your_gke_machine_type>
