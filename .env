# GCP environment variables
GCP_PROJECT_NAME=<your_gcp_project_name>
GCP_REGION=<your_gcp_region>
GCP_ZONE=<your_gcp_zone>

GKE_MACHINE_TYPE=<your_gke_machine_type>
